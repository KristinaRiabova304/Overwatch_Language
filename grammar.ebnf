(* OWL - Overwatch Workshop Language - grammar, stage 2
   Notation: ::= definition, | alternation, { } zero-or-more,
             [ ] optional, " " terminal. *)

(* The top-level statements form the program's entry point; functions are
   declared only at the top level. *)
program         ::= { topItem } ;
topItem         ::= functionDecl | statement ;

(* Functions: "ability" declares a function (a hero's ability takes inputs
   and produces a result). Parameters are typed and immutable. *)
functionDecl    ::= "ability" identifier "(" [ param { "," param } ] ")"
                    "->" typeName block ;
param           ::= identifier ":" typeName ;

statement       ::= varDecl | assignStmt | ifStmt | returnStmt | callStmt ;

(* "gg" ("good game") leaves the current function with a value; at the top
   level it ends the program and the value is its exit code. *)
returnStmt      ::= "gg" expression ";" ;

(* A call used as a statement; its result is discarded. *)
callStmt        ::= call ";" ;
call            ::= identifier "(" [ expression { "," expression } ] ")" ;

(* Variable declarations. "flex" declares a mutable variable (a flex player
   adapts - the value can change). "🔒" declares an immutable (const)
   variable (locked in, cannot change once set). *)
varDecl         ::= declKeyword identifier ":" typeName "=" expression ";" ;
declKeyword     ::= "flex" | "🔒" ;

(* Types: 🔫 is the i32 equivalent, 🚀 is the i64 equivalent,
   "ult" is the boolean type (an ultimate is either charged or not). *)
typeName        ::= "🔫" | "🚀" | "ult" ;

assignStmt      ::= identifier "=" expression ";" ;

ifStmt          ::= "if" expression block [ "else" block ] ;
block           ::= "{" statement { statement } "}" ;

expression      ::= equality ;

(* Comparison: 🆚 is the "==" equivalent, 🚫 is the "!=" equivalent.
   Comparisons do not chain: at most one is allowed per expression. *)
equality        ::= additive [ ( "🆚" | "🚫" ) additive ] ;

(* Each arithmetic operator has an "unchecked" (wrapping) form and a
   "checked" (overflow-checked) form spelled with a trailing "!". Whether a
   checked operation traps on overflow is decided during semantic
   analysis / code generation in the next project stage; here the parser
   only records which form was used. *)
additive        ::= multiplicative { ( "+" | "-" | "+!" | "-!" ) multiplicative } ;
multiplicative  ::= unary { ( "*" | "/" | "*!" | "/!" ) unary } ;

unary           ::= "-" unary | primary ;

primary         ::= intLiteral
                   | boolLiteral
                   | call
                   | identifier
                   | "(" expression ")" ;

(* 🔥 is the "true" equivalent, 💤 is the "false" equivalent. *)
boolLiteral     ::= "🔥" | "💤" ;

intLiteral      ::= digit { digit } ;
identifier      ::= letter { letter | digit | "_" } ;
letter          ::= "a".."z" | "A".."Z" | "_" ;
digit           ::= "0".."9" ;

(* Lexical rules for the stage 2 symbols. "ability" and "gg" are keywords
   and cannot be used as identifiers. "->" is a single token: a "-"
   immediately followed by ">" is always the arrow. *)
arrow           ::= "->" ;
comma           ::= "," ;

(* Comments run from "//" to the end of the line and are discarded by the
   lexer; they never reach the parser or the AST. *)
comment         ::= "//" { any character except newline } newline ;
